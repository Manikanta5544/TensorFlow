# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production (Render), these are set as real environment variables in
# the Render dashboard — never committed. See DEPLOYMENT.md.

APP_NAME=TensorFlow AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local dev default (docker-free): a local Postgres, or point at Supabase.
DATABASE_URL=postgresql+psycopg://tensorflow:tensorflow@localhost:5432/tensorflow_dev

CORS_ORIGINS=http://localhost:5173

# AI provider: "mock" runs fully offline with zero keys (default).
# Switch to "openai_compatible" + set AI_API_KEY to use a real model.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
